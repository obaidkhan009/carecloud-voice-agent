# --- Backend ---
APP_ENV=development
DATABASE_URL=sqlite:///./patients.db
# Railway Postgres example: postgresql://user:pass@host:5432/railway  (driver prefix is added automatically)
SEED_DATA=true
LOG_LEVEL=INFO
LOG_TO_FILE=0

# --- Vapi webhook auth (must equal the assistant's server.secret) ---
VAPI_SECRET=change-me-to-a-long-random-string

# --- Only needed by vapi/push_assistant.py (never by the running API) ---
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
PUBLIC_BASE_URL=https://your-app.up.railway.app
